{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-platform:candidate:requirement-content:0.2.0",
  "title": "Requirement Content Candidate 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["raw_input", "raw_input_ref", "clarification", "baseline"],
  "properties": {
    "raw_input": {"type": "string", "minLength": 1, "readOnly": true},
    "raw_input_ref": {"$ref": "#/$defs/source_ref", "readOnly": true},
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "assessment", "assessment_ref", "assessment_summary", "rounds", "finish_reason"],
      "properties": {
        "mode": {"enum": ["auto", "standard", "deep", "skip"]},
        "assessment": {"anyOf": [{"$ref": "#/$defs/clarification_assessment"}, {"type": "null"}]},
        "assessment_ref": {"anyOf": [{"$ref": "#/$defs/object_ref"}, {"type": "null"}]},
        "assessment_summary": {"type": ["string", "null"], "maxLength": 2000},
        "rounds": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/clarification_round"}},
        "finish_reason": {"type": ["string", "null"], "enum": ["round_limit", "user_finished", "no_new_high_value_question", "mode_skipped", "ai_unavailable_manual", null]}
      }
    },
    "baseline": {"$ref": "#/$defs/baseline"}
  },
  "$defs": {
    "key": {"enum": ["goal", "users_and_roles", "usage_scenarios", "functional_scope", "business_rules", "exception_cases", "permission_requirements", "acceptance_criteria"]},
    "items": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source_ref"}},
    "source_ref": {"type": "object", "additionalProperties": false, "required": ["source_type", "source_id", "source_version_id", "content_hash", "label"], "properties": {"source_type": {"type": "string", "minLength": 1, "maxLength": 64}, "source_id": {"type": "string", "minLength": 1, "maxLength": 128}, "source_version_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "label": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "object_ref": {"type": "object", "additionalProperties": false, "required": ["object_type", "object_id", "object_version_id"], "properties": {"object_type": {"type": "string", "minLength": 1, "maxLength": 64}, "object_id": {"type": "string", "minLength": 1, "maxLength": 128}, "object_version_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}}},
    "clarification_source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}},
    "clarification_assessment_dimension": {"type": "object", "additionalProperties": false, "required": ["status", "missing_items", "source_refs"], "properties": {"status": {"type": "string", "enum": ["complete", "partial", "missing", "not_applicable"]}, "missing_items": {"type": "array", "items": {"type": "string"}}, "source_refs": {"$ref": "#/$defs/clarification_source_refs"}}},
    "clarification_assessment_dimensions": {"type": "object", "additionalProperties": false, "required": ["goal", "users_and_roles", "usage_scenarios", "functional_scope", "business_rules", "exception_cases", "permission_requirements", "acceptance_criteria"], "properties": {"goal": {"$ref": "#/$defs/clarification_assessment_dimension"}, "users_and_roles": {"$ref": "#/$defs/clarification_assessment_dimension"}, "usage_scenarios": {"$ref": "#/$defs/clarification_assessment_dimension"}, "functional_scope": {"$ref": "#/$defs/clarification_assessment_dimension"}, "business_rules": {"$ref": "#/$defs/clarification_assessment_dimension"}, "exception_cases": {"$ref": "#/$defs/clarification_assessment_dimension"}, "permission_requirements": {"$ref": "#/$defs/clarification_assessment_dimension"}, "acceptance_criteria": {"$ref": "#/$defs/clarification_assessment_dimension"}}},
    "clarification_assessment": {"type": "object", "additionalProperties": false, "required": ["assessment_version", "dimensions", "complexity_band", "complexity_reason", "recommended_mode", "missing_dimensions", "source_refs", "ai_result_id"], "properties": {"assessment_version": {"type": "string"}, "dimensions": {"$ref": "#/$defs/clarification_assessment_dimensions"}, "complexity_band": {"type": "string", "enum": ["low", "medium", "high"]}, "complexity_reason": {"type": "string"}, "recommended_mode": {"type": "string", "enum": ["auto", "standard", "deep", "skip"]}, "missing_dimensions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "source_refs": {"$ref": "#/$defs/clarification_source_refs"}, "ai_result_id": {"type": "string"}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["question_id", "dimension", "question_text", "reason", "source_refs"], "properties": {"question_id": {"type": "string", "minLength": 1, "maxLength": 64}, "dimension": {"$ref": "#/$defs/key"}, "question_text": {"type": "string", "minLength": 1, "maxLength": 1000}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}, "source_refs": {"$ref": "#/$defs/refs"}}},
    "answer": {"type": "object", "additionalProperties": false, "required": ["question_id", "answer"], "properties": {"question_id": {"type": "string", "minLength": 1, "maxLength": 64}, "answer": {"type": "string", "minLength": 1, "maxLength": 4000}}},
    "clarification_round": {"type": "object", "additionalProperties": false, "required": ["round_no", "ai_task_id", "ai_result_id", "questions", "answers"], "properties": {"round_no": {"type": "integer", "minimum": 1, "maximum": 5}, "ai_task_id": {"type": "string", "minLength": 1, "maxLength": 64}, "ai_result_id": {"type": "string", "minLength": 1, "maxLength": 64}, "questions": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/question"}}, "answers": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/answer"}}}},
    "dimension": {"type": "object", "additionalProperties": false, "required": ["confirmed_facts", "source_refs", "deferred_items", "not_applicable_items"], "properties": {"confirmed_facts": {"$ref": "#/$defs/items"}, "source_refs": {"$ref": "#/$defs/refs"}, "deferred_items": {"$ref": "#/$defs/items"}, "not_applicable_items": {"$ref": "#/$defs/items"}}},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["dimensions", "assumptions", "unresolved_items"], "properties": {"dimensions": {"type": "object", "additionalProperties": false, "required": ["goal", "users_and_roles", "usage_scenarios", "functional_scope", "business_rules", "exception_cases", "permission_requirements", "acceptance_criteria"], "properties": {"goal": {"$ref": "#/$defs/dimension"}, "users_and_roles": {"$ref": "#/$defs/dimension"}, "usage_scenarios": {"$ref": "#/$defs/dimension"}, "functional_scope": {"$ref": "#/$defs/dimension"}, "business_rules": {"$ref": "#/$defs/dimension"}, "exception_cases": {"$ref": "#/$defs/dimension"}, "permission_requirements": {"$ref": "#/$defs/dimension"}, "acceptance_criteria": {"$ref": "#/$defs/dimension"}}}, "assumptions": {"$ref": "#/$defs/items"}, "unresolved_items": {"$ref": "#/$defs/items"}}}
  }
}
