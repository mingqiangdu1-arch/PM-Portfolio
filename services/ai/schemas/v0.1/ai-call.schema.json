{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-platform:schema:ai-call:0.1.3",
  "title": "AI Call candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "ai_task_id", "sequence_no", "provider_profile_id",
    "model_catalog_id", "skill_version_id", "prompt_version_id",
    "context_strategy_version_id", "runtime_config_version", "status",
    "started_at", "trace_id", "cost_source"
  ],
  "properties": {
    "schema_version": {"const": "0.1.3"},
    "ai_task_id": {"$ref": "#/$defs/id"},
    "sequence_no": {"type": "integer", "minimum": 1, "maximum": 65535},
    "provider_profile_id": {"$ref": "#/$defs/id"},
    "model_catalog_id": {"$ref": "#/$defs/id"},
    "skill_version_id": {"$ref": "#/$defs/id"},
    "prompt_version_id": {"$ref": "#/$defs/id"},
    "template_version_id": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*$"},
    "context_strategy_version_id": {"$ref": "#/$defs/id"},
    "runtime_config_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "capability_fingerprint": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["started", "succeeded", "failed", "cancelled"]},
    "retry_reason": {"type": ["string", "null"], "maxLength": 64},
    "started_at": {"$ref": "#/$defs/time"},
    "finished_at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "billed_tokens": {"type": ["integer", "null"], "minimum": 0},
    "estimated_cost": {"type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$"},
    "currency_code": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "cost_source": {"enum": ["provider_reported", "profile_calculated", "unavailable"]},
    "pricing_version": {"type": ["string", "null"], "maxLength": 32},
    "provider_request_id": {"type": ["string", "null"], "maxLength": 255},
    "failure_code": {"type": ["string", "null"], "maxLength": 64},
    "provider_error_class": {"type": ["string", "null"], "maxLength": 64},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 64}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "time": {"type": "string", "format": "date-time"}
  }
}
