{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-product-platform.local/schemas/v0.1/sprint1-business-event.schema.json",
  "title": "Sprint 1 Business Event Candidate 0.1.3",
  "$comment": "DATA-101 Identity names are Review-accepted. operation_audit_log remains a separate AU fact and is never projected as a canonical behavior event.",
  "allOf": [
    {"$ref": "event-envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "event_name": {
          "enum": [
            "identity.user.registered",
            "identity.session.login_succeeded",
            "identity.session.login_failed",
            "identity.session.refreshed",
            "identity.session.refresh_replay_blocked",
            "identity.session.logged_out",
            "identity.session.revoked",
            "project.project.created",
            "project.project.create_failed",
            "project.project.archived",
            "project.project.restored",
            "project.version.created",
            "project.version.derived",
            "project.version.derive_failed",
            "project.version.working_set",
            "project.version.startup_selected",
            "file.upload.started",
            "file.upload.completed",
            "file.upload.failed"
          ]
        },
        "source_type": {"const": "server"},
        "trace_id": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "required": ["event_name", "trace_id"]
    },
    {
      "if": {"properties": {"event_name": {"pattern": "^project\\."}}, "required": ["event_name"]},
      "then": {
        "properties": {
          "project_id": {"$ref": "event-envelope.schema.json#/$defs/id"},
          "user_id": {"$ref": "event-envelope.schema.json#/$defs/id"}
        },
        "required": ["project_id", "user_id", "command_id"]
      }
    },
    {
      "if": {"properties": {"event_name": {"pattern": "^project\\.version\\."}}, "required": ["event_name"]},
      "then": {
        "properties": {"project_version_id": {"$ref": "event-envelope.schema.json#/$defs/id"}},
        "required": ["project_version_id"]
      }
    },
    {
      "if": {"properties": {"event_name": {"pattern": "^file\\."}}, "required": ["event_name"]},
      "then": {
        "properties": {
          "project_id": {"$ref": "event-envelope.schema.json#/$defs/id"},
          "user_id": {"$ref": "event-envelope.schema.json#/$defs/id"},
          "payload_json": {
            "type": "object",
            "properties": {"file_version_id": {"$ref": "event-envelope.schema.json#/$defs/id"}},
            "required": ["file_version_id"]
          }
        },
        "required": ["project_id", "user_id", "command_id"]
      }
    },
    {
      "if": {"properties": {"event_name": {"pattern": "^identity\\."}}, "required": ["event_name"]},
      "then": {
        "properties": {
          "module": {"const": "identity"},
          "payload_json": {
            "type": "object",
            "propertyNames": {
              "not": {
                "enum": [
                  "email", "password", "access_token", "refresh_token",
                  "token", "cookie", "ip", "user_agent", "ua"
                ]
              }
            }
          }
        },
        "required": ["command_id"]
      }
    },
    {
      "if": {"properties": {"event_name": {"pattern": "(_failed|\\.failed)$"}}, "required": ["event_name"]},
      "then": {
        "properties": {
          "result_status": {"const": "failed"},
          "failure_code": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "required": ["failure_code"]
      }
    },
    {
      "if": {"properties": {"event_name": {"const": "identity.session.refresh_replay_blocked"}}, "required": ["event_name"]},
      "then": {
        "properties": {
          "result_status": {"const": "blocked"},
          "failure_code": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "required": ["failure_code"]
      }
    }
  ]
}
