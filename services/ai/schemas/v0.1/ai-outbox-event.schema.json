{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-product-platform.local/schemas/v0.1/ai-outbox-event.schema.json",
  "title": "AI Outbox Event Candidate 0.1.3",
  "allOf": [
    {"$ref": "event-envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "event_name": {
          "enum": [
            "ai.task.precheck_started", "ai.task.blocked", "ai.task.risk_accepted",
            "ai.task.queued", "ai.task.preparing", "ai.task.generating",
            "ai.task.checking", "ai.task.ready", "ai.task.partial_result",
            "ai.task.quality_blocked", "ai.task.failed", "ai.task.cancelled",
            "ai.task.expired", "ai.task.stale_target", "ai.task.retry_created",
            "ai.call.started", "ai.call.succeeded", "ai.call.failed",
            "ai.context.selected", "ai.result.generated", "ai.result.evaluated"
          ]
        },
        "module": {"const": "ai"},
        "source_type": {"enum": ["ai_service", "worker"]}
      },
      "required": ["ai_task_id"]
    },
    {
      "if": {
        "properties": {"event_name": {"pattern": "^ai\\.task\\."}},
        "required": ["event_name"]
      },
      "then": {
        "properties": {
          "payload_json": {
            "type": "object",
            "required": ["task_status"],
            "properties": {
              "task_status": {
                "enum": [
                  "prechecking", "blocked", "queued", "preparing", "generating",
                  "checking", "ready", "partial_result", "quality_blocked",
                  "cancel_requested", "cancelled", "failed", "expired", "stale_target"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_name": {"enum": ["ai.call.started", "ai.call.succeeded", "ai.call.failed", "ai.context.selected"]}
        },
        "required": ["event_name"]
      },
      "then": {
        "properties": {"ai_call_id": {"$ref": "event-envelope.schema.json#/$defs/id"}},
        "required": ["ai_call_id"]
      }
    },
    {
      "if": {
        "properties": {"event_name": {"enum": ["ai.result.generated", "ai.result.evaluated"]}},
        "required": ["event_name"]
      },
      "then": {
        "properties": {
          "ai_call_id": {"$ref": "event-envelope.schema.json#/$defs/id"},
          "ai_result_id": {"$ref": "event-envelope.schema.json#/$defs/id"},
          "payload_json": {
            "type": "object",
            "required": ["candidate_only"],
            "properties": {"candidate_only": {"const": true}}
          }
        },
        "required": ["ai_call_id", "ai_result_id"]
      }
    }
  ]
}
