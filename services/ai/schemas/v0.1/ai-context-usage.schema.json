{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-platform:schema:ai-context-usage:0.1.3",
  "title": "AI Context Usage candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "ai_call_id", "sequence_no", "source_type",
    "source_id", "retrieval_method", "was_injected", "content_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "0.1.3"},
    "ai_call_id": {"$ref": "#/$defs/id"},
    "sequence_no": {"type": "integer", "minimum": 1, "maximum": 65535},
    "source_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_id": {"$ref": "#/$defs/id"},
    "source_version_id": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*$"},
    "retrieval_method": {"enum": ["direct", "structured", "keyword", "vector", "rule"]},
    "candidate_rank": {"type": ["integer", "null"], "minimum": 1},
    "relevance_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "was_injected": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"], "maxLength": 64},
    "content_fingerprint": {"$ref": "#/$defs/sha256"},
    "content_summary": {"type": ["string", "null"], "maxLength": 2000},
    "token_count": {"type": ["integer", "null"], "minimum": 0}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
