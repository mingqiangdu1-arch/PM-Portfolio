{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-platform:candidate:requirement-clarify-task-envelope:0.2.0",
  "title": "Requirement Clarify Task Envelope Candidate 0.2.0",
  "$comment": "Candidate-only R2 contract. Business API derives and validates input from the addressed Requirement Version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_public_id", "user_id", "project_id", "project_version_id", "module", "task_type", "target", "target_snapshot_hash", "source_ref_ids", "capability_selection", "risk_acceptances", "command_id", "trace_id", "requested_at", "input", "status"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "task_public_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "retry_of_task_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
    "user_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "project_version_id": {"$ref": "#/$defs/id"},
    "module": {"const": "product_design"},
    "task_type": {"const": "requirement.clarify"},
    "target": {"type": "object", "additionalProperties": false, "required": ["object_type", "object_id", "object_version_id"], "properties": {"object_type": {"const": "requirement"}, "object_id": {"$ref": "#/$defs/id"}, "object_version_id": {"$ref": "#/$defs/id"}}},
    "target_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "source_ref_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "capability_selection": {"type": ["object", "null"], "description": "Resolved capability bundle, or null before router selection.", "additionalProperties": true},
    "risk_acceptances": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["risk_id", "impact", "accepted"], "properties": {"risk_id": {"type": "string", "minLength": 1, "maxLength": 128}, "impact": {"enum": ["low", "medium"]}, "accepted": {"const": true}}}},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "requested_at": {"type": "string", "format": "date-time"},
    "input": {"type": "object", "additionalProperties": false, "required": ["mode", "round_no", "continue_deep_confirmed"], "properties": {"mode": {"enum": ["auto", "standard", "deep", "skip"]}, "round_no": {"type": "integer", "minimum": 0, "maximum": 5}, "continue_deep_confirmed": {"type": "boolean"}}, "allOf": [{"if": {"properties": {"mode": {"enum": ["auto", "skip"]}}, "required": ["mode"]}, "then": {"properties": {"round_no": {"const": 0}, "continue_deep_confirmed": {"const": false}}}}, {"if": {"properties": {"mode": {"const": "standard"}}, "required": ["mode"]}, "then": {"properties": {"round_no": {"minimum": 1, "maximum": 3}, "continue_deep_confirmed": {"const": false}}}}, {"if": {"properties": {"mode": {"const": "deep"}}, "required": ["mode"]}, "then": {"properties": {"round_no": {"minimum": 1, "maximum": 5}}}}, {"if": {"properties": {"mode": {"const": "deep"}, "round_no": {"minimum": 4}}, "required": ["mode", "round_no"]}, "then": {"properties": {"continue_deep_confirmed": {"const": true}}}}]},
    "status": {"enum": ["prechecking", "blocked", "queued", "preparing", "generating", "checking", "ready", "partial_result", "quality_blocked", "cancel_requested", "cancelled", "failed", "expired", "stale_target"]},
    "queued_at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "started_at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "finished_at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "failure_code": {"type": ["string", "null"], "maxLength": 64}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[1-9][0-9]*$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time"}}
}
